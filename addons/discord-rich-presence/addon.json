{
  "id": "discord-rich-presence",
  "name": "Discord Rich Presence",
  "version": "1.0.0",
  "description": "Muestra el estado de Neeko en Discord / Shows Neeko status on Discord",
  "author": "Neeko",
  "minAppVersion": "1.2.0",
  "enabled": false,
  "permissions": ["chat:commands", "ui:tabs", "ui:bubble", "native:discord-rpc"],
  "dangerousPermissions": ["discord-rpc"],
  "commands": [
    {
      "id": "drpc-start",
      "description": "Activar Discord Rich Presence / Start Discord Rich Presence",
      "patterns": {
        "es": ["discord\\s+rich\\s+(?:on|activar|iniciar)", "activar\\s+discord\\s+rich", "iniciar\\s+discord\\s+rich"],
        "en": ["discord\\s+rich\\s+(?:on|start|enable)", "start\\s+discord\\s+rich", "enable\\s+discord\\s+rich"]
      }
    },
    {
      "id": "drpc-stop",
      "description": "Desactivar Discord Rich Presence / Stop Discord Rich Presence",
      "patterns": {
        "es": ["discord\\s+rich\\s+(?:off|apagar|desactivar|detener)", "apagar\\s+discord\\s+rich", "desactivar\\s+discord\\s+rich"],
        "en": ["discord\\s+rich\\s+(?:off|stop|disable)", "stop\\s+discord\\s+rich", "disable\\s+discord\\s+rich"]
      }
    },
    {
      "id": "drpc-status",
      "description": "Ver estado de Discord Rich Presence / Check Discord Rich Presence status",
      "patterns": {
        "es": ["estado\\s+discord\\s+rich", "discord\\s+rich\\s+estado"],
        "en": ["discord\\s+rich\\s+status", "status\\s+discord\\s+rich"]
      }
    },
    {
      "id": "drpc-set-state",
      "description": "Cambiar texto de estado / Change status text",
      "patterns": {
        "es": ["discord\\s+rich\\s+texto\\s+(.+)", "discord\\s+rich\\s+estado\\s+(.+)"],
        "en": ["discord\\s+rich\\s+text\\s+(.+)", "discord\\s+rich\\s+state\\s+(.+)"]
      }
    }
  ]
}
