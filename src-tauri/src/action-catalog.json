      },
      "count": {
        "type": "number",
        "min": 1,
        "max": 100,
        "optional": true,
        "integer": true
      }
    }
  },
  "lol_rank": {
    "label": "Consultar rango LoL / LoL rank",
    "fields": {
      "riot_id": {
        "type": "string",
        "optional": true
      },
      "region": {
        "type": "string",
        "optional": true
      }
    }
  },
  "lol_save_config": {
    "label": "Guardar configuración / Save configuration",
    "fields": {
      "git_pat": {
        "type": "string",
        "optional": true
      },
      "region": {
        "type": "string",
        "optional": true
      },
      "git_path": {
        "type": "string",
        "optional": true
      }
    }
  },
