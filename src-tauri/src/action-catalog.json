    "label": "Publicar cambios Git / Push",
    "fields": {
      "path": {
        "type": "string",
        "optional": true
      }
    }
  },
  "git_pull": {
    "label": "Traer cambios Git / Pull",
    "fields": {
      "path": {
        "type": "string",
        "optional": true
      }
    }
  },
  "git_status": {
    "label": "Consultar estado Git / Git status",
    "fields": {
      "path": {
        "type": "string",
        "optional": true
      }
    }
  },
  "git_log": {
    "label": "Consultar historial Git / Git log",
    "fields": {
      "path": {
        "type": "string",
        "optional": true
      },
      "count": {
        "type": "number",
        "min": 1,
        "max": 100,
        "optional": true,
        "integer": true
      }
    }
  },
  "git_branch": {
    "label": "Consultar ramas Git / Git branches",
    "fields": {
      "path": {
        "type": "string",
        "optional": true
      }
    }
  },
