    "label": "Preparar archivos Git / Stage files",
    "fields": {
      "path": {
        "type": "string",
        "optional": true
      },
      "files": {
        "type": "string"
      }
    }
  },
  "git_commit": {
    "label": "Crear commit / Commit",
    "fields": {
      "path": {
        "type": "string",
        "optional": true
      },
