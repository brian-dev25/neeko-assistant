{
  "get_ip": {
    "label": "Consultar IP / Get IP",
    "fields": {}
  },
  "open_app": {
    "label": "Abrir aplicación / Open app",
    "fields": {
      "app": {
        "type": "string"
      }
    }
  },
  "open_url": {
    "label": "Abrir enlace / Open link",
    "fields": {
      "url": {
        "type": "url"
      }
    }
  },
  "search": {
    "label": "Buscar en el sitio indicado / Search specified site",
    "fields": {
      "site": {
        "type": "string",
        "optional": true
      },
      "query": {
        "type": "string"
      }
    }
  },
  "play_music": {
    "label": "Buscar música en YouTube / Find music",
    "fields": {
      "query": {
        "type": "string"
      }
    }
  },
  "open_folder": {
    "label": "Abrir carpeta / Open folder",
    "fields": {
      "folder": {
        "type": "string",
        "values": [
          "desktop",
          "escritorio",
          "downloads",
          "descargas",
          "documents",
          "documentos",
          "home",
          "inicio"
        ]
      }
    }
  },
  "open_compressor_window": {
    "label": "Abrir compresor de video / Open video compressor",
    "fields": {
      "file": {
        "type": "string",
        "optional": true
      },
      "targetSizeMb": {
        "type": "number",
        "min": 1,
        "max": 65536,
        "optional": true,
        "integer": true
      },
      "videoBitrateKbps": {
        "type": "number",
        "min": 1,
        "max": 100000,
        "optional": true,
        "integer": true
      }
    }
  },
  "compress_for_discord": {
    "label": "Comprimir video / Compress video",
    "fields": {
      "file": {
        "type": "string"
      },
      "targetSizeMb": {
        "type": "number",
        "min": 1,
        "max": 65536,
        "optional": true,
        "integer": true
      },
      "videoBitrateKbps": {
        "type": "number",
        "min": 1,
        "max": 100000,
        "optional": true,
        "integer": true
      }
    }
  },
