{
  "$schema": "https://raw.githubusercontent.com/nicklasonmedia/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Neeko Assistant",
  "version": "1.0.4",
  "identifier": "com.neeko.assistant",
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "alwaysOnTop": false,
        "transparent": true,
        "shadow": false,
        "title": "Neeko Assistant",
        "width": 380,
        "height": 600,
        "minWidth": 290,
        "minHeight": 430,
        "resizable": true,
        "decorations": false,
        "skipTaskbar": false,
        "url": "index.html"
      },
      {
        "label": "chat",
        "title": "Chat con Neeko",
        "width": 440,
        "height": 580,
        "minWidth": 320,
        "minHeight": 360,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "focus": false,
        "url": "chat.html"
      },
      {
        "label": "compressor",
        "title": "Compresor de video",
        "width": 760,
        "height": 560,
        "minWidth": 520,
        "minHeight": 430,
        "resizable": true,
        "decorations": false,
        "skipTaskbar": false,
        "visible": false,
        "url": "compress.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    
    "resources": {
      "../addons/quick-notes/": "addons/quick-notes/",
      "../addons/discord-rich-presence/": "addons/discord-rich-presence/",
      "../addons/airi-theme/": "addons/airi-theme/",
      "../addons/shazam/": "addons/shazam/"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCMTgzNkNGNDM0NUNBNkQKUldSdHlrVkR6ellZNjlXZ2dwWVN2ZjJMNU80S3dmMkRjcEpkOWFiaVdmcWFYUGtEK1BmY2VWaTYK",
      "endpoints": [
        "https://github.com/brian-dev25/neeko-assistant/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
