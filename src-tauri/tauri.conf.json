{
  "$schema": "https://raw.githubusercontent.com/nicklasonmedia/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Neeko Assistant",
  "version": "1.0.0",
  "identifier": "com.neeko.assistant",
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Neeko Assistant",
        "width": 380,
        "height": 600,
        "minWidth": 290,
        "minHeight": 430,
        "resizable": true,
        "decorations": false,
        "skipTaskbar": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": "powershell -Command \"New-Item -ItemType Directory -Force -Path 'binaries' | Out-Null; if (!(Test-Path 'binaries/llama-server-x86_64-pc-windows-msvc.exe')) { $bytes = New-Object byte[] 512; $bytes[0] = 0x4D; $bytes[1] = 0x5A; $bytes[2] = 0x90; [System.IO.File]::WriteAllBytes('binaries/llama-server-x86_64-pc-windows-msvc.exe', $bytes) }\""
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/llama-server"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyNzVBRTRGMkFCRUFERTcKUldUbnJiNHFUNjUxRXZkNlUrU1VIL1NENkxnaHFmUFdIQ2RJSE9LdkRHb0dRcVJxK1pIeVk0bTIK",
      "endpoints": [
        "https://github.com/brian-dev25/neeko-assistant/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
