{
  "name": "neeko-assistant",
  "version": "1.0.0",
  "description": "Asistente Neeko - Tu assistente virtual estilo Clippy",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "release": "tauri build",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:TAURI_SIGNING_PRIVATE_KEY=(Get-Content \\\"$env:USERPROFILE\\.tauri\\neeko-assistant.key\\\" -Raw); $env:TAURI_SIGNING_PRIVATE_KEY_PASSWORD=(Get-Content \\\"$env:USERPROFILE\\.tauri\\neeko-assistant.key.password\\\" -Raw); npx tauri build\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
